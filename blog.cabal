name:               blog
version:            0.1.0.0
build-type:         Simple
cabal-version:      >= 1.10

executable site
  main-is:          site.hs
  hs-source-dirs:   ., src
  build-depends:    base == 4.*
                  , hakyll == 4.16.*
                  , time
                  , process
                  , filepath
                  , temporary
                  , text
                  , directory
                  , pandoc
                  , lucid2
                  , texmath >= 0.12
                  , xml
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  default-language: Haskell2010
  other-modules:    SHTML

